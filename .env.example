# 光伏储能地图站 - 环境配置

# ===== 数据库 =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pvmap

# ===== Ollama AI =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== 光伏预测 API =====
FORECAST_API_URL=http://localhost:8001

# ===== Chrome (爬虫) =====
CHROME_PATH=/usr/bin/google-chrome

# ===== 站点 =====
NEXT_PUBLIC_SITE_URL=http://localhost:5000
PORT=5000

# ===== 站点域名（用于GEO/SEO） =====
COZE_PROJECT_DOMAIN_DEFAULT=https://pvmap.example.com

# ===== AI 服务 (至少配置一个) =====
# 智谱AI (推荐, 免费额度): https://open.bigmodel.cn/
ZHIPUAI_API_KEY=
# NVIDIA NIM (备选): https://build.nvidia.com/
NVIDIA_API_KEY=
